<?xml version="1.0"?>
<ruleset name="Bizzio Sync for WooCommerce">
	<description>WordPress Coding Standards + PHP compatibility for the free WP.org plugin.</description>

	<file>bizzio-sync-for-woocommerce</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*.min.js</exclude-pattern>
	<exclude-pattern>*.min.css</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="./"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<!-- Keep in sync with readme.txt "Requires PHP" / "Requires at least". -->
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="bizzio-sync-for-woocommerce"/>
			</property>
		</properties>
	</rule>

	<!-- WP.org review: every global (functions, classes, constants, options, hooks) must be prefixed. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="bizzio_sync_gencloud"/>
				<element value="bizzio"/>
			</property>
		</properties>
	</rule>

	<!-- Debug / dangerous functions must not ship. -->
	<rule ref="Generic.PHP.ForbiddenFunctions">
		<properties>
			<property name="forbiddenFunctions" type="array">
				<element key="var_dump" value="null"/>
				<element key="var_export" value="null"/>
				<element key="print_r" value="null"/>
				<element key="eval" value="null"/>
				<element key="exec" value="null"/>
				<element key="shell_exec" value="null"/>
				<element key="system" value="null"/>
				<element key="passthru" value="null"/>
				<element key="proc_open" value="null"/>
				<element key="popen" value="null"/>
			</property>
		</properties>
	</rule>

	<rule ref="Squiz.PHP.CommentedOutCode"/>
</ruleset>
